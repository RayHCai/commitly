# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/commitly?schema=public

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# JWT (at least 32 characters)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Shared secret for worker to API calls (must match the worker)
SERVICE_TOKEN=

# Frontend (for redirect after OAuth)
FRONTEND_URL=http://localhost:3001

# Worker service
WORKER_URL=http://localhost:8000

# Cache
REDIS_URL=redis://localhost:6379
